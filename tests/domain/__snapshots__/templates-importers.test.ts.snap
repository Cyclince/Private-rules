{
  "baseKind": "mihomo-yaml",
  "body": {
    "cards": [
      {
        "cardId": "direct-rules",
        "enabled": true,
      },
      {
        "cardId": "ai",
        "enabled": true,
      },
      {
        "cardId": "direct-rules-2",
        "enabled": true,
      },
      {
        "cardId": "card-ee2dee37",
        "enabled": true,
      },
    ],
    "clientPatches": {
      "mihomo": "tun:
  enable: true
  stack: mixed
unrecognized-rules:
  - SUB-RULE,(NETWORK,udp),udp-chain",
    },
    "dns": {
      "custom": {
        "nameserver-policy": {
          "geosite:cn": "223.5.5.5",
        },
      },
      "defaultNameserver": [
        "223.5.5.5",
      ],
      "enable": true,
      "fakeIpFilter": [
        "*.lan",
      ],
      "fallback": [
        "https://1.1.1.1/dns-query",
      ],
      "ipv6": false,
      "mode": "fake-ip",
      "nameserver": [
        "https://dns.alidns.com/dns-query",
      ],
      "respectRules": true,
    },
    "final": {
      "cardId": "card-ee2dee37",
      "kind": "card",
    },
    "general": {
      "allowLan": true,
      "ipv6": false,
      "logLevel": "info",
      "mixedPort": 7890,
    },
    "groupMode": "select",
    "modules": [
      {
        "enabled": true,
        "id": "ip-no-resolve",
      },
    ],
    "output": "full",
    "regionGroups": [
      {
        "extraExclude": "倍|实验",
        "extraInclude": "(?i)港|HK|Hong Kong",
        "id": "region-hk",
        "name": "🇭🇰 香港节点",
        "region": "HK",
        "slotId": "slot-airporta",
        "test": {
          "intervalSec": 300,
          "toleranceMs": 50,
          "url": "https://cp.cloudflare.com/generate_204",
        },
        "type": "url-test",
      },
      {
        "extraInclude": "(?i)日本|JP|Tokyo",
        "id": "region-jp",
        "name": "🇯🇵 日本节点",
        "region": "JP",
        "slotId": "slot-airporta",
        "test": {
          "intervalSec": 300,
          "url": "https://cp.cloudflare.com/generate_204",
        },
        "type": "fallback",
      },
    ],
    "slots": [
      {
        "excludeInfo": true,
        "healthCheck": {
          "intervalSec": 300,
          "url": "https://cp.cloudflare.com/generate_204",
        },
        "id": "slot-airporta",
        "name": "AirportA",
        "udp": true,
      },
    ],
  },
  "cards": [
    {
      "category": "domestic",
      "group": {
        "candidates": [
          {
            "id": "DIRECT",
            "kind": "builtin",
          },
        ],
        "type": "select",
      },
      "icon": "domestic",
      "id": "direct-rules",
      "matchers": [
        {
          "conditions": [
            {
              "op": "rule",
              "rule": {
                "type": "DOMAIN-SUFFIX",
                "value": "local",
              },
            },
            {
              "op": "rule",
              "rule": {
                "type": "DOMAIN",
                "value": "router.home",
              },
            },
          ],
          "kind": "inline",
        },
      ],
      "name": "DIRECT",
      "origin": "user",
      "slug": "direct-rules",
      "stage": "domestic",
    },
    {
      "category": "ai",
      "group": {
        "candidates": [
          {
            "kind": "region",
            "regionGroupId": "region-jp",
          },
          {
            "cardId": "card-ee2dee37",
            "kind": "card",
          },
        ],
        "type": "select",
      },
      "icon": "ai",
      "id": "ai",
      "matchers": [
        {
          "behavior": "domain",
          "format": "text",
          "kind": "remote",
          "updateIntervalSec": 28800,
          "url": "https://rules.example/openai.list",
        },
        {
          "kind": "geosite",
          "name": "openai",
        },
        {
          "conditions": [
            {
              "items": [
                {
                  "op": "rule",
                  "rule": {
                    "type": "DOMAIN-SUFFIX",
                    "value": "anthropic.com",
                  },
                },
                {
                  "op": "rule",
                  "rule": {
                    "type": "DST-PORT",
                    "value": "443",
                  },
                },
              ],
              "op": "and",
            },
          ],
          "kind": "inline",
        },
      ],
      "name": "🤖 AI 服务",
      "origin": "user",
      "slug": "ai",
      "stage": "app",
    },
    {
      "category": "domestic",
      "group": {
        "candidates": [
          {
            "id": "DIRECT",
            "kind": "builtin",
          },
        ],
        "type": "select",
      },
      "icon": "domestic",
      "id": "direct-rules-2",
      "matchers": [
        {
          "conditions": [
            {
              "op": "rule",
              "rule": {
                "options": {
                  "noResolve": true,
                },
                "type": "IP-CIDR",
                "value": "2001:db8::/32",
              },
            },
          ],
          "kind": "inline",
        },
        {
          "kind": "geoip",
          "name": "CN",
          "noResolve": true,
        },
      ],
      "name": "DIRECT",
      "origin": "user",
      "slug": "direct-rules-2",
      "stage": "domestic",
    },
    {
      "category": "infrastructure",
      "group": {
        "candidates": [
          {
            "kind": "region",
            "regionGroupId": "region-hk",
          },
          {
            "kind": "region",
            "regionGroupId": "region-jp",
          },
          {
            "id": "DIRECT",
            "kind": "builtin",
          },
          {
            "kind": "slot",
            "slotId": "slot-airporta",
          },
        ],
        "type": "select",
      },
      "icon": "proxy",
      "id": "card-ee2dee37",
      "matchers": [],
      "name": "🚀 节点选择",
      "origin": "user",
      "slug": "card-ee2dee37",
      "stage": "final",
    },
  ],
  "name": "mihomo Inline Sample",
  "report": {
    "importedCards": 4,
    "importedMatchers": 6,
    "importedRegionGroups": 2,
    "items": [
      {
        "code": "YAML_UNRECOGNIZED_SECTION",
        "message": "顶层配置段「tun」未直接映射到中间结构，已保留至 mihomo 客户端补丁。",
        "severity": "info",
        "source": "tun",
      },
      {
        "code": "YAML_PROXIES_IGNORED",
        "message": "已按模板规范忽略 1 条静态 proxies 节点，节点将在发布阶段通过节点槽位绑定。",
        "severity": "info",
        "source": "proxies",
      },
      {
        "code": "YAML_PROVIDER_SECRET_STRIPPED",
        "message": "节点槽位 AirportA 的订阅地址与请求头已脱敏剥离，请在发布时重新绑定订阅地址。",
        "severity": "info",
        "source": "proxy-providers.AirportA",
      },
      {
        "code": "YAML_UNSUPPORTED_GROUP_TYPE",
        "message": "策略组「⛓️ 不支持的组」使用了不支持的类型「relay」，已写入兼容性报告。",
        "raw": "⛓️ 不支持的组 (relay)",
        "severity": "warning",
        "source": "proxy-groups[4]",
      },
      {
        "code": "YAML_UNRECOGNIZED_RULE",
        "message": "规则「SUB-RULE,(NETWORK,udp),udp-chain」使用未识别类型或语法，已保留至兼容性报告与 mihomo 补丁。",
        "raw": "SUB-RULE,(NETWORK,udp),udp-chain",
        "severity": "warning",
        "source": "rules[6]",
      },
      {
        "code": "YAML_DNS_EXTRA_FIELD",
        "message": "DNS 扩展字段 dns.nameserver-policy 已保留在 dns.custom 中。",
        "severity": "info",
        "source": "dns.nameserver-policy",
      },
    ],
    "skippedCount": 2,
    "sourceFormat": "mihomo-yaml",
    "unrecognizedCount": 2,
