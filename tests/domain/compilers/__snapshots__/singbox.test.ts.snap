"{
  "log": {
    "level": "info"
  },
  "dns": {
    "servers": [
      {
        "type": "udp",
        "tag": "dns-bootstrap",
        "server": "223.5.5.5"
      },
      {
        "type": "https",
        "tag": "dns-direct",
        "server": "dns.alidns.com",
        "domain_resolver": "dns-bootstrap"
      },
      {
        "type": "https",
        "tag": "dns-remote",
        "server": "1.1.1.1",
        "detour": "🚀 节点选择"
      },
      {
        "type": "fakeip",
        "tag": "dns-fakeip",
        "inet4_range": "198.18.0.0/15"
      }
    ],
    "rules": [
      {
        "rule_set": [
          "geosite-private",
          "geosite-cn"
        ],
        "server": "dns-direct"
      },
      {
        "domain_suffix": [
          "lan",
          "local",
          "msftconnecttest.com"
        ],
        "server": "dns-direct"
      },
      {
        "query_type": [
          "A"
        ],
        "server": "dns-fakeip"
      }
    ],
    "final": "dns-remote",
    "strategy": "ipv4_only"
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 7890
    }
  ],
  "outbounds": [
    {
      "type": "urltest",
      "tag": "⚡ 自动选择",
