"# Generated by Private Rules (Quantumult X)
# Mode: Experimental Full Config (未经真机验证 — 导入完整配置可能覆盖已有 [server_remote] 订阅)
# Template: 极简模板
# Output: full
# UPDATED: 2026-01-01T00:00:00.000Z

[general]
server_check_url=https://cp.cloudflare.com/generate_204
dns_exclusion_list=*.cmpassport.com, *.jegotrip.com.cn, *.icitymobile.mobi, id6.me, *.local, *.lan, time.*.com, ntp.*.com, *.msftconnecttest.com
excluded_routes=192.168.0.0/16, 172.16.0.0/12, 100.64.0.0/10, 10.0.0.0/8

[dns]
no-ipv6
server=223.5.5.5
server=119.29.29.29
doh-server=https://dns.alidns.com/dns-query
doh-server=https://doh.pub/dns-query

[policy]
# Two-stage node filter (⚡ 自动选择): include=.* | exclude=(?i)(?:流量|到期|官网|官網|剩余|剩餘|过期|過期|重置|套餐|公告|群组|群組|失联|失聯|网址|網址|最新域名|订阅|訂閱|客服|续费|續費|频道|頻道|防失联|Traffic|Expire|Expired|Reset|Website|Official|Remaining|Bandwidth|Support|Channel)
url-latency-benchmark=⚡ 自动选择, server-tag-regex=.*, check-interval=300, tolerance=50
# Two-stage node filter (🚀 节点选择): include=.* | exclude=(?i)(?:流量|到期|官网|官網|剩余|剩餘|过期|過期|重置|套餐|公告|群组|群組|失联|失聯|网址|網址|最新域名|订阅|訂閱|客服|续费|續費|频道|頻道|防失联|Traffic|Expire|Expired|Reset|Website|Official|Remaining|Bandwidth|Support|Channel)
static=🚀 节点选择, ⚡ 自动选择, direct, server-tag-regex=.*
static=🏠 局域网直连, direct, 🚀 节点选择
static=🌐 GFW 代理, 🚀 节点选择, ⚡ 自动选择
static=🇨🇳 国内直连, direct, 🚀 节点选择

[filter_local]
geoip, private, 🏠 局域网直连
geoip, cn, 🇨🇳 国内直连
final, direct

[filter_remote]
https://rules.example.com/rules/geosite-private-qx.list, tag=geosite-private-lan-direct, force-policy=🏠 局域网直连, update-interval=28800, opt-parser=false, enabled=true
https://rules.example.com/rules/geosite-gfw-qx.list, tag=geosite-gfw-gfw-proxy, force-policy=🌐 GFW 代理, update-interval=28800, opt-parser=false, enabled=true
https://rules.example.com/rules/geosite-cn-qx.list, tag=geosite-cn-domestic-direct, force-policy=🇨🇳 国内直连, update-interval=28800, opt-parser=false, enabled=true
"
`;

