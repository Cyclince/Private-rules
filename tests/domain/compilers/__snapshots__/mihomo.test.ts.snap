exports[`compileMihomo — 3 starter tiers × (full/minimal) × (select/fallback) snapshots > matches snapshot and invariants: recommended / minimal / select 1`] = `
"# Generated by Private Rules (mihomo / minimal)
# TEMPLATE: 推荐组合
# UPDATED: 2026-01-01T00:00:00.000Z
proxy-providers:
  slot-main:
    type: http
    url: https://sub.example.com/airport?token=demo
    path: ./providers/proxies/slot-main.yaml
    interval: 3600
    proxy: DIRECT
    header:
      User-Agent:
        - clash-verge/v2.5.1
    exclude-filter: (?i)流量|到期|官网|官網|剩余|剩餘|过期|過期|重置|套餐|公告|群组|群組|失联|失聯|网址|網址|最新域名|订阅|訂閱|客服|续费|續費|频道|頻道|防失联|Traffic|Expire|Expired|Reset|Website|Official|Remaining|Bandwidth|Support|Channel
    override:
      udp: true
    health-check:
      enable: true
      url: https://cp.cloudflare.com/generate_204
      interval: 300
      lazy: true
      timeout: 5000
      expected-status: 204
proxy-groups:
  - name: ⚡ 自动选择
    type: url-test
    use:
      - slot-main
    url: https://cp.cloudflare.com/generate_204
    interval: 300
    tolerance: 50
    lazy: true
    timeout: 5000
    expected-status: 204
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Auto.png
  - name: 🚀 节点选择
    type: select
    proxies:
      - ⚡ 自动选择
      - DIRECT
    use:
      - slot-main
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Proxy.png
  - name: 🏠 局域网直连
    type: select
    proxies:
      - DIRECT
