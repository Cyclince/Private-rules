rule-providers:
  catalog-domestic-direct-custom:
    type: http
    behavior: classical
    format: text
    url: https://raw.githubusercontent.com/Aethersailor/Custom_OpenClash_Rules/main/rule/Custom_Direct.list
    path: ./providers/rules/catalog-domestic-direct-custom.list
    interval: 1800
  catalog-gaming-steam-cn:
    type: http
    behavior: classical
    format: text
    url: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/SteamCN/SteamCN.list
    path: ./providers/rules/catalog-gaming-steam-cn.list
    interval: 28800
  catalog-infra-tunnel-direct:
    type: http
