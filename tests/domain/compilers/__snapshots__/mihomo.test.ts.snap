"
`;

exports[`compileMihomo — 3 starter tiers × (full/minimal) × (select/fallback) snapshots > matches snapshot and invariants: all / minimal / fallback 1`] = `
"# Generated by Private Rules (mihomo / minimal)
# TEMPLATE: 全都要
# UPDATED: 2026-01-01T00:00:00.000Z
proxy-providers:
  slot-main:
    type: http
    url: https://sub.example.com/airport?token=demo
    path: ./providers/proxies/slot-main.yaml
    interval: 3600
    proxy: DIRECT
    header:
      User-Agent:
        - clash-verge/v2.5.1
    exclude-filter: (?i)流量|到期|官网|官網|剩余|剩餘|过期|過期|重置|套餐|公告|群组|群組|失联|失聯|网址|網址|最新域名|订阅|訂閱|客服|续费|續費|频道|頻道|防失联|Traffic|Expire|Expired|Reset|Website|Official|Remaining|Bandwidth|Support|Channel
    override:
      udp: true
    health-check:
      enable: true
      url: https://cp.cloudflare.com/generate_204
      interval: 300
      lazy: true
      timeout: 5000
      expected-status: 204
proxy-groups:
  - name: ⚡ 自动选择
    type: url-test
    use:
      - slot-main
    url: https://cp.cloudflare.com/generate_204
    interval: 300
    tolerance: 50
    lazy: true
    timeout: 5000
    expected-status: 204
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Auto.png
  - name: 🚀 节点选择
    type: select
    proxies:
      - ⚡ 自动选择
      - 🇭🇰 香港节点
      - 🇹🇼 台湾节点
      - 🇯🇵 日本节点
      - 🇸🇬 新加坡节点
      - 🇺🇸 美国节点
      - 🇰🇷 韩国节点
      - 🇬🇧 英国节点
      - 🇩🇪 德国节点
      - 🇫🇷 法国节点
      - 🇳🇱 荷兰节点
      - 🇨🇦 加拿大节点
      - 🇦🇺 澳大利亚节点
      - DIRECT
    use:
      - slot-main
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Proxy.png
  - name: 🏠 局域网直连
    type: select
    proxies:
      - DIRECT
      - 🚀 节点选择
    hidden: true
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Direct.png
  - name: 🧭 常用直连补充
    type: select
    proxies:
      - DIRECT
      - 🚀 节点选择
    hidden: true
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Direct.png
  - name: 🛡️ 广告拦截
    type: select
    proxies:
      - REJECT
      - REJECT-DROP
      - DIRECT
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Advertising.png
  - name: 🎮 游戏下载直连
    type: select
    proxies:
      - DIRECT
      - 🚀 节点选择
    hidden: true
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Game.png
  - name: 🔗 局域网与内网穿透直连
    type: select
    proxies:
      - DIRECT
      - 🚀 节点选择
    hidden: true
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Direct.png
  - name: 🤖 OpenAI / ChatGPT
    type: fallback
    proxies:
      - 🇺🇸 美国节点
      - 🇯🇵 日本节点
      - 🇸🇬 新加坡节点
      - 🇹🇼 台湾节点
      - 🚀 节点选择
    url: https://cp.cloudflare.com/generate_204
    interval: 300
    lazy: true
    timeout: 5000
    expected-status: 204
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Bot.png
  - name: ✨ AI 服务
    type: fallback
    proxies:
      - 🇺🇸 美国节点
      - 🇯🇵 日本节点
      - 🇸🇬 新加坡节点
      - 🇹🇼 台湾节点
      - 🚀 节点选择
    url: https://cp.cloudflare.com/generate_204
    interval: 300
    lazy: true
    timeout: 5000
    expected-status: 204
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Bot.png
  - name: ✈️ Telegram
    type: fallback
    proxies:
      - 🚀 节点选择
      - ⚡ 自动选择
      - 🇭🇰 香港节点
      - 🇹🇼 台湾节点
      - 🇯🇵 日本节点
      - 🇸🇬 新加坡节点
      - 🇺🇸 美国节点
      - 🇰🇷 韩国节点
      - DIRECT
    url: https://cp.cloudflare.com/generate_204
    interval: 300
    lazy: true
    timeout: 5000
    expected-status: 204
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Telegram.png
  - name: 𝕏 X / Twitter
    type: fallback
    proxies:
      - 🚀 节点选择
      - ⚡ 自动选择
      - 🇭🇰 香港节点
      - 🇹🇼 台湾节点
      - 🇯🇵 日本节点
      - 🇸🇬 新加坡节点
      - 🇺🇸 美国节点
      - 🇰🇷 韩国节点
      - DIRECT
    url: https://cp.cloudflare.com/generate_204
    interval: 300
    lazy: true
    timeout: 5000
    expected-status: 204
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Twitter.png
  - name: 💬 Discord
    type: fallback
    proxies:
      - 🚀 节点选择
      - ⚡ 自动选择
      - 🇭🇰 香港节点
      - 🇹🇼 台湾节点
      - 🇯🇵 日本节点
      - 🇸🇬 新加坡节点
