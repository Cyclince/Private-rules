  - name: 🔌 非标准端口
    type: select
    proxies:
      - 🚀 节点选择
      - ⚡ 自动选择
      - DIRECT
    hidden: true
  - name: 🐟 漏网之鱼
    type: select
    proxies:
      - 🚀 节点选择
      - ⚡ 自动选择
      - DIRECT
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Final.png
