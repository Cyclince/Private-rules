exports[`compileMihomo — 3 starter tiers × (full/minimal) × (select/fallback) snapshots > matches snapshot and invariants: less / full / fallback 1`] = `
"# Generated by Private Rules (mihomo / full)
# TEMPLATE: 少一点
# UPDATED: 2026-01-01T00:00:00.000Z
mixed-port: 7890
allow-lan: false
mode: rule
log-level: info
ipv6: false
unified-delay: true
tcp-concurrent: true
find-process-mode: strict
profile:
  store-selected: true
  store-fake-ip: true
dns:
  enable: true
  ipv6: false
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  fake-ip-filter:
    - "*.lan"
    - "*.local"
    - time.*.com
    - ntp.*.com
    - +.msftconnecttest.com
  respect-rules: true
  default-nameserver:
    - 223.5.5.5
    - 119.29.29.29
  nameserver:
    - https://1.1.1.1/dns-query
    - https://dns.google/dns-query
  proxy-server-nameserver:
    - https://dns.alidns.com/dns-query
    - https://doh.pub/dns-query
  nameserver-policy:
    geosite:cn:
      - https://dns.alidns.com/dns-query
      - https://doh.pub/dns-query
    geosite:private:
      - https://dns.alidns.com/dns-query
      - https://doh.pub/dns-query
sniffer:
  enable: true
  force-dns-mapping: true
  parse-pure-ip: true
  override-destination: true
  sniff:
    HTTP:
      ports:
        - 80
        - 8080-8880
      override-destination: true
    TLS:
      ports:
        - 443
        - 8443
    QUIC:
      ports:
        - 443
        - 8443
  skip-domain:
    - Mijia Cloud
    - +.push.apple.com
    - +.lan
    - +.local
proxy-providers:
  slot-main:
    type: http
    url: https://sub.example.com/airport?token=demo
    path: ./providers/proxies/slot-main.yaml
    interval: 3600
    proxy: DIRECT
    header:
      User-Agent:
        - clash-verge/v2.5.1
    exclude-filter: (?i)流量|到期|官网|官網|剩余|剩餘|过期|過期|重置|套餐|公告|群组|群組|失联|失聯|网址|網址|最新域名|订阅|訂閱|客服|续费|續費|频道|頻道|防失联|Traffic|Expire|Expired|Reset|Website|Official|Remaining|Bandwidth|Support|Channel
    override:
      udp: true
    health-check:
      enable: true
      url: https://cp.cloudflare.com/generate_204
      interval: 300
      lazy: true
      timeout: 5000
      expected-status: 204
proxy-groups:
  - name: ⚡ 自动选择
    type: url-test
    use:
      - slot-main
    url: https://cp.cloudflare.com/generate_204
    interval: 300
    tolerance: 50
    lazy: true
    timeout: 5000
    expected-status: 204
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Auto.png
  - name: 🚀 节点选择
    type: select
    proxies:
      - ⚡ 自动选择
      - DIRECT
    use:
      - slot-main
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Proxy.png
  - name: 🏠 局域网直连
    type: select
    proxies:
      - DIRECT
      - 🚀 节点选择
    hidden: true
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Direct.png
  - name: 🤖 OpenAI / ChatGPT
    type: fallback
    proxies:
      - 🚀 节点选择
      - ⚡ 自动选择
    url: https://cp.cloudflare.com/generate_204
    interval: 300
    lazy: true
    timeout: 5000
    expected-status: 204
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Bot.png
  - name: ✨ AI 服务
    type: fallback
    proxies:
      - 🚀 节点选择
      - ⚡ 自动选择
    url: https://cp.cloudflare.com/generate_204
    interval: 300
    lazy: true
    timeout: 5000
    expected-status: 204
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Bot.png
  - name: 🌐 GFW 代理
    type: fallback
    proxies:
      - 🚀 节点选择
      - ⚡ 自动选择
    url: https://cp.cloudflare.com/generate_204
    interval: 300
    lazy: true
    timeout: 5000
    expected-status: 204
    hidden: true
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Proxy.png
  - name: 🇨🇳 国内直连
    type: select
    proxies:
      - DIRECT
      - 🚀 节点选择
    hidden: true
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Direct.png
  - name: 🐟 漏网之鱼
    type: select
    proxies:
      - 🚀 节点选择
      - ⚡ 自动选择
      - DIRECT
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Final.png
rule-providers:
  geosite-private:
    type: http
    behavior: domain
    format: mrs
    url: https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/private.mrs
    path: ./providers/rules/geosite-private.mrs
    interval: 86400
  geoip-private:
    type: http
    behavior: ipcidr
    format: mrs
    url: https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geoip/private.mrs
    path: ./providers/rules/geoip-private.mrs
    interval: 86400
  geosite-openai:
    type: http
    behavior: domain
    format: mrs
    url: https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/openai.mrs
    path: ./providers/rules/geosite-openai.mrs
    interval: 86400
  geosite-category-ai--cn:
    type: http
    behavior: domain
    format: mrs
    url: https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/category-ai-!cn.mrs
    path: ./providers/rules/geosite-category-ai--cn.mrs
    interval: 86400
  geosite-gfw:
    type: http
    behavior: domain
    format: mrs
    url: https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/gfw.mrs
    path: ./providers/rules/geosite-gfw.mrs
    interval: 86400
  geosite-cn:
    type: http
    behavior: domain
    format: mrs
    url: https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/cn.mrs
    path: ./providers/rules/geosite-cn.mrs
    interval: 86400
  geoip-cn:
    type: http
    behavior: ipcidr
    format: mrs
    url: https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geoip/cn.mrs
    path: ./providers/rules/geoip-cn.mrs
    interval: 86400
rules:
  - RULE-SET,geosite-private,🏠 局域网直连
  - RULE-SET,geoip-private,🏠 局域网直连,no-resolve
  - RULE-SET,geosite-openai,🤖 OpenAI / ChatGPT
  - RULE-SET,geosite-category-ai--cn,✨ AI 服务
  - RULE-SET,geosite-gfw,🌐 GFW 代理
  - RULE-SET,geosite-cn,🇨🇳 国内直连
  - RULE-SET,geoip-cn,🇨🇳 国内直连,no-resolve
  - MATCH,🐟 漏网之鱼
"
`;

