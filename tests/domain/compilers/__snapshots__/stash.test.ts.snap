exports[`compileStash — 4 starter tiers × (full/minimal) × (select/fallback) snapshots > matches snapshot and invariants: light / full / fallback 1`] = `
"# Generated by Private Rules (stash / full)
# TEMPLATE: 轻量模板
# UPDATED: 2026-01-01T00:00:00.000Z
allow-lan: false
mode: rule
log-level: info
ipv6: false
dns:
  ipv6: false
  default-nameserver:
    - 223.5.5.5
    - 119.29.29.29
  nameserver:
    - https://dns.alidns.com/dns-query
    - https://doh.pub/dns-query
  fallback:
    - https://1.1.1.1/dns-query
    - https://dns.google/dns-query
  fake-ip-range: 198.18.0.1/16
  fake-ip-filter:
    - "*.lan"
    - "*.local"
    - time.*.com
    - ntp.*.com
    - +.msftconnecttest.com
proxy-providers:
  slot-main:
    url: https://sub.example.com/airport?token=demo
    path: ./providers/proxies/slot-main.yaml
    interval: 3600
    filter: (?i)^(?!.*(?:流量|到期|官网|官網|剩余|剩餘|过期|過期|重置|套餐|公告|群组|群組|失联|失聯|网址|網址|最新域名|订阅|訂閱|客服|续费|續費|频道|頻道|防失联|Traffic|Expire|Expired|Reset|Website|Official|Remaining|Bandwidth|Support|Channel)).*$
    headers:
      User-Agent: Stash/3.7.0
proxy-groups:
  - name: ⚡ 自动选择
    type: url-test
    use:
      - slot-main
    benchmark-url: https://cp.cloudflare.com/generate_204
    interval: 300
    tolerance: 50
  - name: 🚀 节点选择
    type: select
    proxies:
      - ⚡ 自动选择
      - 🇭🇰 香港节点
      - 🇹🇼 台湾节点
      - 🇯🇵 日本节点
      - 🇸🇬 新加坡节点
      - 🇺🇸 美国节点
      - 🇰🇷 韩国节点
      - DIRECT
    use:
      - slot-main
  - name: 🏠 局域网直连
    type: select
    proxies:
      - DIRECT
      - 🚀 节点选择
  - name: 🛡️ 广告拦截
    type: select
    proxies:
      - REJECT
      - REJECT-DROP
      - DIRECT
  - name: ✨ AI 服务
    type: fallback
    proxies:
      - 🇺🇸 美国节点
      - 🇯🇵 日本节点
      - 🇸🇬 新加坡节点
