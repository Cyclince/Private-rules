    type: url-test
    use:
      - slot-main
    filter: (?i)🇰🇷|韩国|韓國|首尔|首爾|春川|釜山|仁川|南韩|南韓|South[ _-]?Korea|(?<![A-Za-z])(?:Korea)(?![A-Za-z])|(?<![A-Za-z])(?:Seoul)(?![A-Za-z])|Chuncheon|(?<![A-Za-z])(?:Busan)(?![A-Za-z])|Incheon|(?<![A-Za-z])(?:KR|KOR|ICN|SEL)(?![A-Za-z])|(?<!北)韩|(?<!北)韓
    benchmark-url: https://cp.cloudflare.com/generate_204
    interval: 300
    tolerance: 50
rules:
  - GEOSITE,private,🏠 局域网直连
  - GEOIP,PRIVATE,🏠 局域网直连,no-resolve
  - GEOSITE,category-ads-all,🛡️ 广告拦截
