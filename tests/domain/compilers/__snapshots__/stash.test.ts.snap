    interval: 300
  - name: 🇨🇳 国内直连
    type: select
    proxies:
      - DIRECT
      - 🚀 节点选择
rules:
  - GEOSITE,private,🏠 局域网直连
  - GEOIP,PRIVATE,🏠 局域网直连,no-resolve
  - GEOSITE,gfw,🌐 GFW 代理
  - GEOSITE,cn,🇨🇳 国内直连
  - GEOIP,CN,🇨🇳 国内直连,no-resolve
  - MATCH,DIRECT
"
`;

