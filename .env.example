# 必填：管理后台登录密码
ADMIN_PASSWORD=
# 强烈建议配置（至少 32 位随机字符串，可用 `openssl rand -hex 32` 生成）
# 1.1.0 模板发布绑定节点订阅地址时必须显式配置此项，配置后请勿随意更改
SESSION_SECRET=
# 必填：私密订阅令牌（/sub/<RULE_TOKEN>/... 与 /t/<RULE_TOKEN>/...）
RULE_TOKEN=
# 推荐：对外访问的公网 HTTPS 地址（启用 Telegram 或自定义域名时必需）
BASE_URL=https://rules.example.com

# 可选：反代与运行参数（默认已适配反向代理部署）
TRUST_PROXY=true
LOG_LEVEL=info
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60

# 可选：Telegram Bot 与 Mini App
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=
TELEGRAM_WEBHOOK_SECRET=
