# 必填：管理后台登录密码
ADMIN_PASSWORD=
# 必填：私密订阅令牌（/sub/<RULE_TOKEN>/... 与 /t/<RULE_TOKEN>/...）
RULE_TOKEN=
# 推荐：对外访问的公网 HTTPS 地址（启用 Telegram 或自定义域名时必需）
BASE_URL=https://rules.example.com

# 可选：自定义会话与节点加密密钥（留空时首次启动自动生成并持久化；自定义时生产环境需 ≥ 32 位，修改后已保存的节点订阅需重填）
# SESSION_SECRET=

# 可选：Telegram Bot 与 Mini App
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=
