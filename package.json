{
  "name": "private-rules-worker",
  "version": "1.1.0-beta.1",
  "private": true,
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "description": "Private self-hosted rules console for Cloudflare Workers and Docker Compose.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:node": "tsx watch src/runtimes/node.ts",
    "start": "node dist/server/node.js",
    "build": "pnpm build:client && pnpm build:server && pnpm prepare:cloudflare-deploy",
    "build:client": "pnpm i18n:generate && vite build",
    "build:server": "tsup src/runtimes/node.ts --format esm --platform node --out-dir dist/server --clean --external better-sqlite3",
    "prepare:cloudflare-deploy": "node scripts/prepare-cloudflare-deploy.mjs",
    "i18n:generate": "tsx scripts/generate-zh-tw.ts",
    "check:contrast": "tsx scripts/check-contrast.ts",
    "size": "tsx scripts/bundle-size.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:contract": "vitest run tests/contract",
    "test:api": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:telegram": "vitest run tests/integration/telegram.test.ts tests/unit/source-security.test.ts",
    "preview": "vite preview",
    "deploy": "wrangler deploy --keep-vars",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:migrate:node": "tsx scripts/migrate-node.ts",
    "format": "prettier --write --ignore-unknown \"src/shared\" \"src/domain\" \"src/builtin\" \"src/data\" \"src/application/auth\" \"src/application/backup\" \"src/application/cards\" \"src/application/catalog\" \"src/application/publications\" \"src/application/rulesets\" \"src/application/settings\" \"src/application/sources\" \"src/application/sync\" \"src/application/templates\" \"src/infrastructure/http\" \"src/infrastructure/logging\" \"src/infrastructure/crypto\" \"src/runtimes/worker.ts\" \"src/server\" \"src/web\" \"scripts/bundle-size.ts\" \"scripts/check-contrast.ts\" \"scripts/generate-zh-tw.ts\" \"tests/shared\" \"tests/domain\" \"tests/contract/templates-publications.test.ts\" \"tests/unit/contrast.test.ts\" \"tests/unit/http-fetch.test.ts\" \"tests/unit/logger.test.ts\" \"tests/unit/node-secrets.test.ts\" \"tests/unit/node-snapshots.test.ts\" \"tests/unit/sync-scheduler.test.ts\" \"tests/unit/web-cards-and-publications.test.ts\" \"tests/unit/web-i18n-and-assets.test.ts\" \"tests/unit/web-query-and-api.test.ts\" \"tests/unit/web-template-editor.test.ts\" \"tests/integration/migration.test.ts\" \"tests/integration/node-static-assets.test.ts\" \"tests/integration/publications-and-templates.test.ts\" \"tests/integration/rulesets-pagination.test.ts\" \"tests/integration/security-hardening.test.ts\" \"tests/integration/subscriptions-cache.test.ts\" \"tests/e2e/preview-layout.spec.ts\" \"tests/e2e/preview-auth-and-telegram.spec.ts\" \"tests/e2e/preview-rulesets-and-rules.spec.ts\" \"tests/e2e/preview-sources-settings-backup.spec.ts\" \"tests/e2e/preview-catalog-cards-publications.spec.ts\" \"tests/e2e/preview-templates-editor.spec.ts\" drizzle.config.ts eslint.config.js",
    "format:check": "prettier --check --ignore-unknown \"src/shared\" \"src/domain\" \"src/builtin\" \"src/data\" \"src/application/auth\" \"src/application/backup\" \"src/application/cards\" \"src/application/catalog\" \"src/application/publications\" \"src/application/rulesets\" \"src/application/settings\" \"src/application/sources\" \"src/application/sync\" \"src/application/templates\" \"src/infrastructure/http\" \"src/infrastructure/logging\" \"src/infrastructure/crypto\" \"src/runtimes/worker.ts\" \"src/server\" \"src/web\" \"scripts/bundle-size.ts\" \"scripts/check-contrast.ts\" \"scripts/generate-zh-tw.ts\" \"tests/shared\" \"tests/domain\" \"tests/contract/templates-publications.test.ts\" \"tests/unit/contrast.test.ts\" \"tests/unit/http-fetch.test.ts\" \"tests/unit/logger.test.ts\" \"tests/unit/node-secrets.test.ts\" \"tests/unit/node-snapshots.test.ts\" \"tests/unit/sync-scheduler.test.ts\" \"tests/unit/web-cards-and-publications.test.ts\" \"tests/unit/web-i18n-and-assets.test.ts\" \"tests/unit/web-query-and-api.test.ts\" \"tests/unit/web-template-editor.test.ts\" \"tests/integration/migration.test.ts\" \"tests/integration/node-static-assets.test.ts\" \"tests/integration/publications-and-templates.test.ts\" \"tests/integration/rulesets-pagination.test.ts\" \"tests/integration/security-hardening.test.ts\" \"tests/integration/subscriptions-cache.test.ts\" \"tests/e2e/preview-layout.spec.ts\" \"tests/e2e/preview-auth-and-telegram.spec.ts\" \"tests/e2e/preview-rulesets-and-rules.spec.ts\" \"tests/e2e/preview-sources-settings-backup.spec.ts\" \"tests/e2e/preview-catalog-cards-publications.spec.ts\" \"tests/e2e/preview-templates-editor.spec.ts\" drizzle.config.ts eslint.config.js",
    "test:shared": "vitest run tests/shared",
    "test:domain": "vitest run tests/domain"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.44.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hono/node-server": "^2.1.11",
    "@hono/zod-validator": "^0.9.1",
    "@hookform/resolvers": "^7.0.9",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.108.4",
    "@tanstack/react-router": "^1.170.46",
    "better-sqlite3": "^12.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.23",
    "lucide-react": "^1.81.0",
    "motion": "^14.14.0",
    "react-hook-form": "^7.92.0",
    "tailwind-merge": "^3.7.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.11.6",
    "@cloudflare/workers-types": "^5.20260708.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/router-plugin": "^1.169.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.6.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "miniflare": "^4.20260702.0",
    "opencc-js": "^1.4.0",
    "prettier": "^3.10.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.3.5",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.74.0",
    "vite": "^7.0.5",
    "vitest": "^4.0.18",
    "wrangler": "^4.24.0"
  }
}
