{
  "name": "private-rules-worker",
  "version": "1.1.0-alpha.0",
  "private": true,
  "packageManager": "pnpm@10.11.1",
  "type": "module",
  "description": "Private self-hosted rules console for Cloudflare Workers and Docker Compose.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:node": "tsx watch src/runtimes/node.ts",
    "start": "node dist/server/node.js",
    "build": "pnpm build:client && pnpm build:server && pnpm prepare:cloudflare-deploy",
    "build:client": "vite build",
    "build:server": "tsup src/runtimes/node.ts --format esm --platform node --out-dir dist/server --clean --external better-sqlite3",
    "prepare:cloudflare-deploy": "node scripts/prepare-cloudflare-deploy.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:contract": "vitest run tests/contract",
    "test:api": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:telegram": "vitest run tests/integration/telegram.test.ts tests/unit/source-security.test.ts",
    "preview": "vite preview",
    "deploy": "wrangler deploy --keep-vars",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:migrate:node": "tsx scripts/migrate-node.ts",
    "format": "prettier --write --ignore-unknown \"src/shared\" \"src/domain\" \"src/data\" \"src/infrastructure/http\" \"src/infrastructure/logging\" \"src/infrastructure/crypto\" \"src/server/middleware\" \"tests/shared\" \"tests/domain\" \"tests/unit/http-fetch.test.ts\" \"tests/unit/logger.test.ts\" \"tests/unit/node-secrets.test.ts\" \"tests/integration/migration.test.ts\" drizzle.config.ts eslint.config.js",
    "format:check": "prettier --check --ignore-unknown \"src/shared\" \"src/domain\" \"src/data\" \"src/infrastructure/http\" \"src/infrastructure/logging\" \"src/infrastructure/crypto\" \"src/server/middleware\" \"tests/shared\" \"tests/domain\" \"tests/unit/http-fetch.test.ts\" \"tests/unit/logger.test.ts\" \"tests/unit/node-secrets.test.ts\" \"tests/integration/migration.test.ts\" drizzle.config.ts eslint.config.js",
    "test:shared": "vitest run tests/shared",
    "test:domain": "vitest run tests/domain"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.9",
    "@hono/zod-validator": "^0.9.1",
    "better-sqlite3": "^12.4.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.8.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.11.6",
    "@cloudflare/workers-types": "^5.20260708.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.6.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "miniflare": "^4.20260702.0",
    "opencc-js": "^1.4.0",
    "prettier": "^3.10.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.74.0",
    "vite": "^7.0.5",
    "vitest": "^4.0.18",
    "wrangler": "^4.24.0"
  }
}
